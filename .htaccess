Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|lock|md|sh)$">
  Require all denied
</FilesMatch>

# Authorization-Header für MCP/API an PHP durchreichen (php-fpm/CGI)
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
